{
  "$schema": "https://smithery.ai/schema/manifest.json",
  "name": "nerd-utility-api",
  "displayName": "Nerd Utility API",
  "description": "26 free micro-service endpoints for AI agents: JSON/CSV formatting, hashing, base64, UUID, QR codes, DNS lookup, header echo, IP geolocation, web text extraction, crypto prices, price alerts, random, password, lorem, slugify, case, url-encode, and more. No auth, no API keys.",
  "runtime": "node",
  "startCommand": "node mcp-server.js",
  "tools": [
    { "name": "format_json", "description": "Pretty-print or minify JSON" },
    { "name": "csv2json", "description": "Convert CSV to JSON" },
    { "name": "json2csv", "description": "Convert JSON to CSV" },
    { "name": "base64", "description": "Base64 encode/decode" },
    { "name": "hash", "description": "Hash text (md5/sha1/sha256/sha512)" },
    { "name": "uuid", "description": "Generate UUID v4" },
    { "name": "timestamp", "description": "Unix <-> ISO timestamp conversion" },
    { "name": "text_stats", "description": "Word/char counts for text" },
    { "name": "qrcode", "description": "Generate QR code PNG" },
    { "name": "dns_lookup", "description": "DNS lookups (A, AAAA, MX, TXT, CNAME)" },
    { "name": "echo_headers", "description": "Echo request headers" },
    { "name": "ip_info", "description": "Client IP geolocation" },
    { "name": "scrape_text", "description": "Fetch and extract text from a URL" },
    { "name": "crypto_price", "description": "Crypto price lookup (BTC, ETH, ...)" },
    { "name": "price_history", "description": "Crypto price history" },
    { "name": "price_alerts", "description": "Price watchdog rules management" },
    { "name": "random_number", "description": "Random number in range" },
    { "name": "generate_password", "description": "Strong password generator" },
    { "name": "lorem_ipsum", "description": "Lorem ipsum generator" },
    { "name": "slugify", "description": "URL slug from text" },
    { "name": "case_convert", "description": "Upper/lower/title case" },
    { "name": "url_encode", "description": "Percent encode/decode" }
  ],
  "keywords": ["utility", "formatting", "hashing", "qrcode", "dns", "scraping", "crypto", "free"],
  "license": "MIT",
  "sourceUrl": "local",
  "pricing": "free"
}
